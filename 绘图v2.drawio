        <mxCell id="xiyLIqlMgkYHxB2dxlbb-24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F1FB;strokeColor=#6E9ED2;strokeWidth=1.5;fontColor=#1D4776;fontFamily=Microsoft YaHei;fontSize=16;align=left;verticalAlign=middle;spacing=10;arcSize=10;" value="&lt;b&gt;科学问题&lt;/b&gt;&lt;br&gt;如何客观识别大范围臭氧污染，并解释其频率、持续时间、覆盖范围、强度及季节窗口的变化？" vertex="1">
          <mxGeometry height="102" width="310" x="515.1023101806641" y="611.3750152587891" as="geometry" />
        </mxCell>
        <mxCell id="xiyLIqlMgkYHxB2dxlbb-25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#66AB9F;strokeWidth=1.5;fontColor=#175D54;fontFamily=Microsoft YaHei;fontSize=16;align=left;verticalAlign=middle;spacing=10;arcSize=10;" value="&lt;b&gt;科学问题&lt;/b&gt;&lt;br&gt;分散的区域污染如何扩展、合并和连接？多尺度天气过程如何通过生成、边界层与输送推动尺度跃迁？" vertex="1">
