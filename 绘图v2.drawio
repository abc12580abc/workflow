        <mxCell id="xiyLIqlMgkYHxB2dxlbb-26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF0E5;strokeColor=#D3945F;strokeWidth=1.5;fontColor=#7D421B;fontFamily=Microsoft YaHei;fontSize=16;align=left;verticalAlign=middle;spacing=10;arcSize=10;" value="&lt;b&gt;科学问题&lt;/b&gt;&lt;br&gt;排放持续下降期间，大范围污染为何增加？气象、排放及其非线性交互分别贡献多少？" vertex="1">
