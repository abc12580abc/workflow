        <mxCell id="xiyLIqlMgkYHxB2dxlbb-29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B5C8DB;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=middle;spacing=10;arcSize=10;" value="&lt;b&gt;研究任务&lt;/b&gt;&lt;br&gt;重建生成—扩展—合并—消散过程；识别尺度跃迁前兆；检验共同生成、输送连接和生成—输送复合三类路径。" vertex="1">
          <mxGeometry height="104" width="310" x="915.1023101806641" y="729.3750152587891" as="geometry" />
        </mxCell>
